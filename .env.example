# Harbor Haven Home Watch — environment variables. No values here; copy to .env
# and fill in per environment (local / Railway staging / Railway production).

# Postgres connection string (Railway provides this).
DATABASE_URL=

# Session signing secret. Required — the app refuses to start without it.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Cloudflare R2 (receipt photos). Optional in HH-01: when unset, expenses save
# without a photo URL and the upload is skipped (logged).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for served photos (R2 public bucket or custom domain).
R2_PUBLIC_URL=

# Square (HH-02 seam — not used by HH-01 code).
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Resend (HH-02 seam — not used by HH-01 code).
RESEND_API_KEY=
