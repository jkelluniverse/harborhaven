generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
}

enum JobType {
  PERMIT_ONLY
  PROJECT
  HOME_WATCH
  OTHER
}

enum ClientStatus {
  LEAD
  ACTIVE
  ARCHIVED
}

enum ClientSource {
  WEBSITE
  PHONE
  REFERRAL
  OTHER
}

enum VisitFrequency {
  WEEKLY
  BIWEEKLY
  CUSTOM
}

enum JobStatus {
  ESTIMATE
  ACTIVE
  DONE
  PAID
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELED
}

enum PaymentMethod {
  SQUARE
  OTHER
}

enum LineItemKind {
  PERMIT
  MANAGEMENT_FEE
  MATERIALS
  LABOR
  HOME_WATCH_VISIT
  OTHER
}

enum PayableStatus {
  OWED
  PAID
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id               Int          @id @default(autoincrement())
  name             String       @unique
  phone            String?
  email            String?
  notes            String?
  // Lead intake (website form / phone). LEAD until "Start estimate" flips it.
  status           ClientStatus @default(LEAD)
  source           ClientSource @default(OTHER)
  propertyAddress  String?
  serviceRequested String?
  leadNotes        String?
  preferredDates   String?
  archiveReason    String?
  // Square Customer linked to this client (upserted on first invoice send).
  squareCustomerId String?
  jobs             Job[]
  createdAt        DateTime     @default(now())
}

model Job {
  id        Int       @id @default(autoincrement())
  client    Client    @relation(fields: [clientId], references: [id])
  clientId  Int
  name      String
  address   String
  type      JobType
  status    JobStatus @default(ESTIMATE)
  // Multiplier applied to expense cost when clientPrice isn't set explicitly.
  // Seeded app-wide default lives in AppSetting "markup_default".
  markup    Decimal   @default(1.2) @db.Decimal(6, 3)
  // Read-only public estimate page lives at /e/[estimateToken].
  estimateToken  String?   @unique
  estimateSentAt DateTime?
  // Home watch: schedule + per-visit rate. Home-watch jobs stay ACTIVE
  // indefinitely and are never auto-flipped PAID.
  visitFrequency VisitFrequency?
  visitRate      Decimal?  @db.Decimal(12, 2)
  nextVisitDue   DateTime?
  visits         Visit[]
  expenses  Expense[]
  invoices  Invoice[]
  payments  Payment[]
  lineItems LineItem[]
  payables  Payable[]
  notes     JobNote[]
  history   StatusHistory[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model LineItem {
  id          Int          @id @default(autoincrement())
  job         Job          @relation(fields: [jobId], references: [id])
  jobId       Int
  // Set once the item lands on an invoice; null = unbilled.
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  invoiceId   Int?
  description String
  qty         Decimal      @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal      @db.Decimal(12, 2)
  kind        LineItemKind @default(OTHER)
  // Billable expenses become line items at clientPrice; this remembers which.
  sourceExpense   Expense? @relation(fields: [sourceExpenseId], references: [id])
  sourceExpenseId Int?     @unique
  payables    Payable[]
  createdAt   DateTime     @default(now())
}

model Payable {
  id         Int           @id @default(autoincrement())
  job        Job           @relation(fields: [jobId], references: [id])
  jobId      Int
  lineItem   LineItem?     @relation(fields: [lineItemId], references: [id])
  lineItemId Int?
  payeeName  String
  amount     Decimal       @db.Decimal(12, 2)
  status     PayableStatus @default(OWED)
  paidAt     DateTime?
  paidVia    String?
  note       String?
  createdAt  DateTime      @default(now())
}

model Expense {
  id          Int      @id @default(autoincrement())
  job         Job      @relation(fields: [jobId], references: [id])
  jobId       Int
  cost        Decimal  @db.Decimal(12, 2)
  // What the client is charged for this expense. Defaults to cost * job.markup
  // at creation time when not given explicitly.
  clientPrice Decimal? @db.Decimal(12, 2)
  billable    Boolean  @default(true)
  category    String?
  vendor      String?
  notes       String?
  costDate    DateTime?
  // R2 object key + public URL for the receipt photo (seam: lib/storage.ts).
  photoKey    String?
  photoUrl    String?
  lineItem    LineItem?
  createdAt   DateTime @default(now())
}

model Invoice {
  id              Int           @id @default(autoincrement())
  job             Job           @relation(fields: [jobId], references: [id])
  jobId           Int
  totalAmount     Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(UNPAID)
  dueDate         DateTime?
  // Staged-billing label: "Deposit", "Progress 1", "Final" — free text.
  stage           String?
  // Square Invoices linkage (set when the invoice is sent through Square).
  squareInvoiceId     String?  @unique
  squareOrderId       String?  @unique
  squareInvoiceStatus String?
  publicUrl           String?
  sentAt              DateTime?
  lineItems       LineItem[]
  payments        Payment[]
  issuedAt        DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Payment {
  id              Int           @id @default(autoincrement())
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  invoiceId       Int
  job             Job           @relation(fields: [jobId], references: [id])
  jobId           Int
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod @default(OTHER)
  note            String?
  // Square payment id — unique so webhook replays can't double-post.
  squarePaymentId String?       @unique
  // Square's processing fee, when reported.
  feeAmount       Decimal?      @db.Decimal(12, 2)
  receivedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
}

/// Webhook idempotency lock: the unique create IS the claim; a duplicate
/// delivery loses the race and stops.
model WebhookEvent {
  id          String    @id
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

/// One home-watch visit: checklist results, photos, notes, and the sent
/// report (stored so it can be resent).
model Visit {
  id           Int       @id @default(autoincrement())
  job          Job       @relation(fields: [jobId], references: [id])
  jobId        Int
  visitedAt    DateTime  @default(now())
  // [{ item: "AC/thermostat", ok: false, note?: "set to 82" }, …]
  checklist    Json
  notes        String?
  // [{ key, url }] via the R2 seam (lib/storage.ts)
  photos       Json      @default("[]")
  reportHtml   String?
  reportSentAt DateTime?
  createdAt    DateTime  @default(now())
}

/// Every outbound SMS, with delivery status (Twilio sid when accepted).
model SmsLog {
  id          Int      @id @default(autoincrement())
  to          String
  body        String
  status      String // sent | failed | skipped (unconfigured)
  providerSid String?
  createdAt   DateTime @default(now())
}

model JobNote {
  id        Int      @id @default(autoincrement())
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     Int
  note      String
  author    String
  createdAt DateTime @default(now())
}

model StatusHistory {
  id         Int      @id @default(autoincrement())
  job        Job      @relation(fields: [jobId], references: [id])
  jobId      Int
  fromStatus String?
  toStatus   String
  changedBy  String
  note       String?
  changedAt  DateTime @default(now())
}

model AppSetting {
  key       String   @id
  value     String?
  updatedAt DateTime @default(now()) @updatedAt
}
